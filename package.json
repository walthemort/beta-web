{
  "name": "beta-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "test": "node --test tests/*.test.mjs",
    "build:portal": "node scripts/build-portal.mjs",
    "build:clients": "node scripts/build-client-strip.mjs",
    "build:admin": "node scripts/build-admin.mjs",
    "build": "npm run build:studio && npm run build:comparison && npm run build:admin && npm run build:clients && npm run build:portal",
    "test:portal": "npm --prefix portal test -- src/__tests__/cloud-db.test.ts src/__tests__/cloud-sync.test.ts",
    "test:budget": "node scripts/performance-budget.mjs",
    "build:comparison": "node scripts/build-comparison.mjs",
    "test:ui": "node scripts/check-comparison.mjs",
    "test:adaptive": "node scripts/check-adaptive.mjs",
    "build:studio": "node scripts/build-studio.mjs",
    "test:studio": "node scripts/check-studio.mjs",
    "test:experiences": "node scripts/check-case-experiences.mjs",
    "build:reel": "node scripts/build-studio-reel.mjs",
    "test:hero": "node scripts/check-hero.mjs",
    "test:overhaul": "node scripts/check-overhaul.mjs",
    "test:lab": "node scripts/check-lab.mjs",
    "test:services": "node scripts/check-services.mjs",
    "test:projects": "node scripts/check-projects.mjs",
    "profile:scroll": "node scripts/profile-scroll.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "playwright": "1.64.0",
    "undici": "7.30.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "esbuild": "0.25.12"
  }
}
