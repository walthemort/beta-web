PORT=3000
# Optional business overrides; owner editor can set these without a restart.
BOOKING_URL=
CONTACT_EMAIL=
SITE_URL=
# Included editable Beta portal source; sibling Forme is an optional alternative.
FORME_PATH=./portal
# Existing public values default to content/business.json. Never use a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_BETA_STUDIO_ID=
VITE_BETA_WEBSITE_URL=/
# Optional external portal deployment instead of the included bundle.
PORTAL_URL=
# Browser rendering attempts require a working Chromium sandbox; source fallback remains available.
RENDER_REVIEW=true
# Optional installed Chromium path (otherwise Playwright browser, or /usr/bin/chromium when present).
CHROMIUM_PATH=
