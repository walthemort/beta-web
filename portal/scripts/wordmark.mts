/**
 * Turns the wordmark into outlines: "af" in Inter Tight ExtraLight and "tryk" in Inter Tight Bold,
 * spaced as the design (-0.04em / -0.05em). The light half comes first so the word presses down as
 * it is read – and "tryk" (the press, the print) is the half that carries the meaning. Writes
 * src/components/wordmark.ts, which the logo draws from – so it looks the same everywhere, font or
 * no font.
 *   npx tsx scripts/wordmark.mts
 * Inter Tight: SIL Open Font License 1.1 (outlining it for a logo is allowed).
 */
import { readFileSync, writeFileSync } from 'node:fs'
import { createRequire } from 'node:module'
import opentype from 'opentype.js'

const require = createRequire(import.meta.url)
const font = (w: number) => {
  const buf = readFileSync(require.resolve(`@fontsource/inter-tight/files/inter-tight-latin-${w}-normal.woff`))
  return opentype.parse(buf.buffer.slice(buf.byteOffset, buf.byteOffset + buf.byteLength))
}
const bold = font(700)
const light = font(200)
const SIZE = 100 // one em, in the logo's own units

/** Sets `text` from x letter by letter, with kerning and CSS-style letter-spacing after each letter. */
function set(f: opentype.Font, text: string, x: number, spacing: number, into: opentype.Path) {
  const scale = SIZE / f.unitsPerEm
  const glyphs = [...text].map((ch) => f.charToGlyph(ch))
  const parts: string[] = []
  glyphs.forEach((g, i) => {
    const p = g.getPath(x, 0, SIZE)
    into.extend(p)
    parts.push(p.toPathData({ decimalPlaces: 2, flipY: false }))
    let kern = 0
    try {
      if (i < glyphs.length - 1) kern = f.getKerningValue(g, glyphs[i + 1])
    } catch {
      /* no kerning table for this pair */
    }
    x += (g.advanceWidth! + kern) * scale + spacing * SIZE
  })
  return { d: parts.join(''), end: x }
}

const all = new opentype.Path()
const first = set(light, 'af', 0, -0.04, all)
const second = set(bold, 'tryk', first.end, -0.05, all)
// The mark: the same idea in two letters – a hairline a and a bold t, which read "at" (Danish for
// "to", as in "at trykke", to press).
const mono = new opentype.Path()
const a = set(light, 'a', 0, -0.02, mono)
const t = set(bold, 't', a.end, 0, mono)
const b = all.getBoundingBox()
const fb = mono.getBoundingBox()
const r = (n: number) => Math.round(n * 100) / 100
writeFileSync(
  new URL('../src/components/wordmark.ts', import.meta.url),
  `/** Generated by scripts/wordmark.mts – the wordmark as outlines (Inter Tight, SIL OFL 1.1). Don't edit by hand. */
export const WORDMARK = {
  /** x, y, width, height of what's drawn – the baseline is y = 0. */
  viewBox: [${r(b.x1)}, ${r(b.y1)}, ${r(b.x2 - b.x1)}, ${r(b.y2 - b.y1)}] as const,
  /** The two weights, named for what they are – so a change of name never reaches the logo code. */
  light: '${first.d}',
  bold: '${second.d}',
}

/** The mark: a hairline a and a bold t – the app icon. */
export const MONOGRAM = {
  viewBox: [${r(fb.x1)}, ${r(fb.y1)}, ${r(fb.x2 - fb.x1)}, ${r(fb.y2 - fb.y1)}] as const,
  light: '${a.d}',
  bold: '${t.d}',
}
`,
)
console.log('wordmark', b, 'mark', fb)
